{
  "manifest_version": 3,
  "name": "__MSG_extName__",
  "version": "0.7.1",
  "description": "__MSG_extDesc__",
  "default_locale": "en",
  "permissions": ["scripting", "storage", "unlimitedStorage", "activeTab"],
  "host_permissions": [
    "https://*.notion.so/*",
    "https://*.notion.com/*",
    "https://*.notionusercontent.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "__MSG_actionTitle__",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  }
}
